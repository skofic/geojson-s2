	{ "label": "Polygon: no rings", "geometry": { "type": "Polygon", "coordinates": [] }, "expect": { "ok": false, "codes": ["EMPTY_COORDINATES"] } },

	{ "label": "Polygon: valid with clockwise hole", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [10, 0], [10, 10], [0, 10], [0, 0]], [[2, 2], [2, 4], [4, 4], [4, 2], [2, 2]]] }, "expect": { "ok": true, "codes": [] } },
	{ "label": "Polygon: counter-clockwise hole (ArangoDB inverts it)", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [10, 0], [10, 10], [0, 10], [0, 0]], [[2, 2], [4, 2], [4, 4], [2, 4], [2, 2]]] }, "expect": { "ok": true, "codes": ["HOLE_NOT_CW"] } },
	{ "label": "Polygon: hole outside exterior ring", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [1, 0], [1, 1], [0, 1], [0, 0]], [[5, 5], [5, 6], [6, 6], [6, 5], [5, 5]]] }, "expect": { "ok": false, "codes": ["HOLE_NOT_INSIDE_EXTERIOR"] } },
	{ "label": "Polygon: hole crosses exterior ring", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [10, 0], [10, 10], [0, 10], [0, 0]], [[8, 8], [8, 12], [12, 12], [12, 8], [8, 8]]] }, "expect": { "ok": false, "codes": ["HOLE_CROSSES_EXTERIOR"] } },
	{ "label": "Polygon: two crossing holes", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [20, 0], [20, 20], [0, 20], [0, 0]], [[2, 2], [2, 8], [8, 8], [8, 2], [2, 2]], [[6, 6], [6, 12], [12, 12], [12, 6], [6, 6]]] }, "expect": { "ok": false, "codes": ["HOLES_OVERLAP"] } },
	{ "label": "Polygon: two holes touching at a vertex (ArangoDB accepts)", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [20, 0], [20, 20], [0, 20], [0, 0]], [[2, 2], [2, 6], [6, 6], [6, 2], [2, 2]], [[6, 6], [6, 10], [10, 10], [10, 6], [6, 6]]] }, "expect": { "ok": true, "codes": ["HOLES_TOUCH"] } },
	{ "label": "Polygon: two disjoint holes", "geometry": { "type": "Polygon", "coordinates": [[[0, 0], [20, 0], [20, 20], [0, 20], [0, 0]], [[2, 2], [2, 4], [4, 4], [4, 2], [2, 2]], [[10, 10], [10, 12], [12, 12], [12, 10], [10, 10]]] }, "expect": { "ok": true, "codes": [] } },

	{ "label": "Polygon: spans the antimeridian without splitting", "geometry": { "type": "Polygon", "coordinates": [[[-170, 0], [170, 0], [170, 10], [-170, 10], [-170, 0]]] }, "expect": { "ok": true, "codes": ["ANTIMERIDIAN_SPAN"] } },

